// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                String   @id @default(cuid())
  workspaceId       String   @default("default")
  email             String   @unique
  did               String?  @unique
  password          String
  firstName         String
  lastName          String
  walletAddress     String?  @unique
  githubId          Int?     @unique
  githubUsername    String?
  githubAvatarUrl   String?
  githubAccessToken String?
  // Additive nullable column (zero-downtime expand phase, #1426 / BE-HARD-35)
  profileTag        String?
  discordId         String?  @unique
  discordUsername   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments      Enrollment[]
  certificates     Certificate[]
  feedback         Feedback[]
  learningProgress LearningProgress[]
  canvases         Canvas[]
  ideas            Idea[]
  votes            Vote[]
  passkeyCredentials PasskeyCredential[]
  webauthnCredentials WebAuthnCredential[]
  hashSimulations  HashSimulation[]
  subscriptions    Subscription[]

  @@index([workspaceId, email])
  @@index([firstName, lastName])
  @@index([email])
  @@index([createdAt])
  @@index([githubId])
  @@index([discordId])
  @@map("students")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKeyX   String
  publicKeyY   String
  signCount    Int       @default(0)
  userId       String
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  student      Student   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

/// FIDO2/WebAuthn passkey bound to a student (BE-008).
model WebAuthnCredential {
  id                String    @id @default(cuid())
  studentId         String
  /// base64url credential ID chosen by the authenticator
  credentialId      String    @unique
  /// COSE_Key-encoded credential public key
  publicKey         Bytes
  /// COSE algorithm identifier (-7 ES256, -8 EdDSA, -257 RS256, ...)
  algorithm         Int
  /// Authenticator signature counter (uint32, hence BigInt)
  signCount         BigInt    @default(0)
  transports        String[]  @default([])
  aaguid            String?
  attestationFormat String
  /// none | self | basic
  attestationType   String
  userVerified      Boolean   @default(false)
  backupEligible    Boolean   @default(false)
  backedUp          Boolean   @default(false)
  deviceName        String?
  /// Set when a signature-counter regression indicates a cloned authenticator; the credential is then refused
  cloneDetectedAt   DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("webauthn_credentials")
}

/// Single-use WebAuthn challenge nonce with a 60-second TTL (BE-008).
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  /// base64url-encoded 32-byte random nonce
  challenge String   @unique
  /// registration | authentication
  ceremony  String
  studentId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model OAuthState {
  id        String    @id @default(cuid())
  state     String    @unique
  provider  String    @default("github")
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}

model Course {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  title       String
  description String?
  instructor  String
  credits     Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments      Enrollment[]
  certificates     Certificate[]
  feedback         Feedback[]
  learningProgress LearningProgress[]

  @@index([workspaceId, title])
  @@index([title])
  @@index([instructor])
  @@index([credits])
  @@index([createdAt])
  @@map("courses")
}

model Certificate {
  id                String    @id @default(cuid())
  workspaceId       String    @default("default")
  studentId         String
  courseId          String
  tokenId           String    @unique
  issuedAt          DateTime  @default(now())
  certificateHash   String?
  status            String    @default("pending") // MINTED, ACTIVE, REVOKED, REISSUED, EXPIRED
  did               String?
  metadataUri       String?
  contractAddress   String?
  network           String?
  grade             String?
  revokedAt         DateTime?
  revocationReason  String?
  revokedBy         String?
  previousVersionId String?
  transactionHash   String?
  contentHash       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student            Student                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course             Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  verificationEvents CertificateVerificationEvent[]

  @@index([status])
  @@index([issuedAt])
  @@index([studentId])
  @@index([courseId])
  @@index([studentId, status])
  @@index([courseId, issuedAt])
  @@map("certificates")
}

model CertificateVerificationEvent {
  id            String   @id @default(cuid())
  workspaceId   String   @default("default")
  certificateId String?
  tokenId       String
  createdAt     DateTime @default(now())

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([certificateId])
  @@index([tokenId])
  @@index([createdAt])
  @@map("certificate_verification_events")
}

model MerkleCohortRoot {
  cohortId   String    @id @map("cohort_id")
  rootHash   String    @map("root_hash")
  anchoredAt DateTime? @default(now()) @map("anchored_at") @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([cohortId], map: "idx_merkle_cohort_roots_cohort_id")
  @@map("merkle_cohort_roots")
}

model Enrollment {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  studentId   String
  courseId    String
  enrolledAt  DateTime @default(now())
  status      String   @default("active")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model PeerReviewAssignment {
  id              String    @id @default(cuid())
  workspaceId     String    @default("default")
  courseId        String
  assignmentId    String
  reviewerId      String
  revieweeId      String
  reviewerAlias   String
  revieweeAlias   String
  reviewerSubnet  String?
  revieweeSubnet  String?
  teamId          String?
  status          String    @default("assigned") // assigned, submitted, disputed, escalated, closed
  grade           Float?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviewer PeerReviewGrade[] @relation("ReviewerGrades")

  @@unique([assignmentId, reviewerId, revieweeId])
  @@index([courseId, assignmentId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([status])
  @@map("peer_review_assignments")
}

model PeerReviewGrade {
  id           String   @id @default(cuid())
  assignmentId String
  reviewerId   String
  revieweeId   String
  score        Float
  createdAt    DateTime @default(now())
  assignment PeerReviewAssignment @relation("ReviewerGrades", fields: [assignmentId], references: [id], onDelete: Cascade)
  @@index([assignmentId])
  @@index([revieweeId])
  @@map("peer_review_grades")
}

model PeerReviewDispute {
  id           String    @id @default(cuid())
  assignmentId String
  varianceBps  Int
  status       String    @default("open") // open, resolved
  arbiterId    String?
  resolution   Float?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([assignmentId])
  @@index([status])
  @@map("peer_review_disputes")
}

model Feedback {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  studentId   String
  courseId    String
  rating      Int // Rating from 1 to 5
  review      String? // Optional text review
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId]) // One review per student per course
  @@map("feedback")
}

model LearningProgress {
  id               String    @id @default(cuid())
  workspaceId      String    @default("default")
  studentId        String
  courseId         String
  completedLessons Json // Array of lesson ids for PostgreSQL
  currentModuleId  String?
  percentage       Int       @default(0)
  status           String    @default("not_started")
  lastAccessedAt   DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([lastAccessedAt])
  @@map("learning_progress")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  userId      String?
  userEmail   String?
  action      String
  entity      String?
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  prevHash    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model AuthNonce {
  id            String   @id @default(cuid())
  walletAddress String
  nonce         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
  @@index([expiresAt])
  @@map("auth_nonces")
}

model AnalyticsData {
  id                 String   @id @default(cuid())
  metricType         String // "USER_STAT", "COURSE_STAT", "ENROLLMENT_STAT"
  anonymizedUserHash String? // SHA-256 of email
  region             String? // Aggregated location
  value              Float?   @db.Real
  category           String? // course category, level, etc.
  timestamp          DateTime @default(now())
  metadata           Json?

  @@map("analytics_data")
}

model Canvas {
  id             String    @id @default(cuid())
  workspaceId    String    @default("default")
  roomId         String    @unique
  studentId      String
  title          String
  description    String?
  data           Json? // Stores canvas state/shapes
  isPublic       Boolean   @default(false)
  collaborators  Json // Array of student IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastModifiedBy String?
  lastModifiedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([studentId])
  @@index([createdAt])
  @@map("canvases")
}
