// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                String   @id @default(cuid())
  workspaceId       String   @default("default")
  email             String   @unique
  did               String?  @unique
  password          String
  firstName         String
  lastName          String
  walletAddress     String?  @unique
  githubId          Int?     @unique
  githubUsername    String?
  githubAvatarUrl   String?
  githubAccessToken String?
  // Additive nullable column (zero-downtime expand phase, #1426 / BE-HARD-35)
  profileTag        String?
  discordId         String?  @unique
  discordUsername   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments      Enrollment[]
  certificates     Certificate[]
  feedback         Feedback[]
  learningProgress LearningProgress[]
  canvases         Canvas[]
  ideas            Idea[]
  votes            Vote[]
  passkeyCredentials PasskeyCredential[]
  webauthnCredentials WebAuthnCredential[]
  hashSimulations  HashSimulation[]
  subscriptions    Subscription[]

  @@index([workspaceId, email])
  @@index([firstName, lastName])
  @@index([email])
  @@index([createdAt])
  @@index([githubId])
  @@index([discordId])
  @@map("students")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKeyX   String
  publicKeyY   String
  signCount    Int       @default(0)
  userId       String
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  student      Student   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

/// FIDO2/WebAuthn passkey bound to a student (BE-008).
model WebAuthnCredential {
  id                String    @id @default(cuid())
  studentId         String
  /// base64url credential ID chosen by the authenticator
  credentialId      String    @unique
  /// COSE_Key-encoded credential public key
  publicKey         Bytes
  /// COSE algorithm identifier (-7 ES256, -8 EdDSA, -257 RS256, ...)
  algorithm         Int
  /// Authenticator signature counter (uint32, hence BigInt)
  signCount         BigInt    @default(0)
  transports        String[]  @default([])
  aaguid            String?
  attestationFormat String
  /// none | self | basic
  attestationType   String
  userVerified      Boolean   @default(false)
  backupEligible    Boolean   @default(false)
  backedUp          Boolean   @default(false)
  deviceName        String?
  /// Set when a signature-counter regression indicates a cloned authenticator; the credential is then refused
  cloneDetectedAt   DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("webauthn_credentials")
}

/// Single-use WebAuthn challenge nonce with a 60-second TTL (BE-008).
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  /// base64url-encoded 32-byte random nonce
  challenge String   @unique
  /// registration | authentication
  ceremony  String
  studentId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model OAuthState {
  id        String    @id @default(cuid())
  state     String    @unique
  provider  String    @default("github")
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}

model Course {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  title       String
  description String?
  instructor  String
  credits     Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments      Enrollment[]
  certificates     Certificate[]
  feedback         Feedback[]
  learningProgress LearningProgress[]

  @@index([workspaceId, title])
  @@index([title])
  @@index([instructor])
  @@index([credits])
  @@index([createdAt])
  @@map("courses")
}

model Certificate {
  id                String    @id @default(cuid())
  workspaceId       String    @default("default")
  studentId         String
  courseId          String
  tokenId           String    @unique
  issuedAt          DateTime  @default(now())
  certificateHash   String?
  status            String    @default("pending") // MINTED, ACTIVE, REVOKED, REISSUED, EXPIRED
  did               String?
  metadataUri       String?
  contractAddress   String?
  network           String?
  grade             String?
  revokedAt         DateTime?
  revocationReason  String?
  revokedBy         String?
  previousVersionId String?
  transactionHash   String?
  contentHash       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student            Student                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course             Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  verificationEvents CertificateVerificationEvent[]

  @@index([status])
  @@index([issuedAt])
  @@index([studentId])
  @@index([courseId])
  @@index([studentId, status])
  @@index([courseId, issuedAt])
  @@map("certificates")
}

model CertificateVerificationEvent {
  id            String   @id @default(cuid())
  workspaceId   String   @default("default")
  certificateId String?
  tokenId       String
  createdAt     DateTime @default(now())

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([certificateId])
  @@index([tokenId])
  @@index([createdAt])
  @@map("certificate_verification_events")
}

model MerkleCohortRoot {
  cohortId   String   @id
  rootHash   String
  anchoredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cohortId])
  @@map("merkle_cohort_roots")
}

model Enrollment {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  studentId   String
  courseId    String
  enrolledAt  DateTime @default(now())
  status      String   @default("active")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model Feedback {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  studentId   String
  courseId    String
  rating      Int // Rating from 1 to 5
  review      String? // Optional text review
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId]) // One review per student per course
  @@map("feedback")
}

model LearningProgress {
  id               String    @id @default(cuid())
  workspaceId      String    @default("default")
  studentId        String
  courseId         String
  completedLessons Json // Array of lesson ids for PostgreSQL
  currentModuleId  String?
  percentage       Int       @default(0)
  status           String    @default("not_started")
  lastAccessedAt   DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([lastAccessedAt])
  @@map("learning_progress")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  userId      String?
  userEmail   String?
  action      String
  entity      String?
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  prevHash    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

model AuthNonce {
  id            String   @id @default(cuid())
  walletAddress String
  nonce         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
  @@index([expiresAt])
  @@map("auth_nonces")
}

model AnalyticsData {
  id                 String   @id @default(cuid())
  metricType         String // "USER_STAT", "COURSE_STAT", "ENROLLMENT_STAT"
  anonymizedUserHash String? // SHA-256 of email
  region             String? // Aggregated location
  value              Float?
  category           String? // course category, level, etc.
  timestamp          DateTime @default(now())
  metadata           Json?

  @@map("analytics_data")
}

model Canvas {
  id             String    @id @default(cuid())
  workspaceId    String    @default("default")
  roomId         String    @unique
  studentId      String
  title          String
  description    String?
  data           Json? // Stores canvas state/shapes
  isPublic       Boolean   @default(false)
  collaborators  Json // Array of student IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastModifiedBy String?
  lastModifiedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([studentId])
  @@index([createdAt])
  @@map("canvases")
}

model DecentralizedAsset {
  id             String    @id @default(cuid())
  workspaceId    String    @default("default")
  resourceType   String
  resourceId     String
  name           String
  kind           String
  provider       String    @default("pinata")
  cid            String    @unique
  ipfsUri        String
  gatewayUrl     String
  mimeType       String?
  sizeBytes      Int?
  status         String    @default("queued")
  referenceCount Int       @default(1)
  metadata       Json?
  error          String?
  pinnedAt       DateTime?
  unpinnedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, resourceType, resourceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, resourceType, resourceId])
  @@map("decentralized_assets")
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  url         String
  secret      String?
  events      Json // Array of event names e.g., ["lesson.completed"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, url])
  @@map("webhook_subscriptions")
}

model NotificationPreferences {
  id              String   @id @default(cuid())
  workspaceId     String   @default("default")
  studentId       String
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  courseUpdates   Boolean  @default(true)
  announcements   Boolean  @default(true)
  newCourses      Boolean  @default(true)
  reminders       Boolean  @default(true)
  frequency       String   @default("immediate")
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId])
  @@index([studentId])
  @@index([workspaceId, studentId])
  @@map("notification_preferences")
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  lessonId  String
  action    String
  timestamp DateTime @default(now())

  @@map("student_activities")
}

model TranslationEntry {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  locale      String
  namespace   String   @default("platform")
  key         String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, locale, namespace, key])
  @@index([workspaceId, locale, namespace])
  @@map("translation_entries")
}

model VestingSchedule {
  id             String   @id @default(cuid())
  workspaceId    String   @default("default")
  projectId      String   @unique
  tokenName      String
  tokenSymbol    String
  amount         Float
  cliffMonths    Int
  durationMonths Int
  beneficiary    String
  claimedAmount  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@map("vesting_schedules")
}

model Idea {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  title       String
  description String
  studentId   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  votes   Vote[]

  @@index([workspaceId])
  @@index([studentId])
  @@map("ideas")
}

model Vote {
  id        String   @id @default(cuid())
  ideaId    String
  studentId String
  value     Int // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())

  idea    Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([ideaId, studentId])
  @@map("votes")
}

model HashSimulation {
  id        String   @id @default(cuid())
  studentId String
  inputData String
  hashType  String // e.g., "SHA-256"
  hashValue String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("hash_simulations")
}

model P2PNode {
  id          String   @id @default(cuid())
  workspaceId String   @default("default")
  nodeId      String   @unique
  nodeName    String
  status      String   @default("online")
  ipAddress   String?
  port        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messagesSent     P2PMessage[] @relation("MessagesSent")
  messagesReceived P2PMessage[] @relation("MessagesReceived")

  @@index([workspaceId])
  @@map("p2p_nodes")
}

model P2PMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  payload    Json
  status     String   @default("pending") // pending, delivered, failed
  createdAt  DateTime @default(now())

  sender   P2PNode @relation("MessagesSent", fields: [senderId], references: [nodeId], onDelete: Cascade)
  receiver P2PNode @relation("MessagesReceived", fields: [receiverId], references: [nodeId], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@map("p2p_messages")
}

model ProcessedBlock {
  id           String    @id @default(cuid())
  chain        String
  blockNumber  Int
  blockHash    String    @unique
  parentHash   String
  timestamp    DateTime  @default(now())
  processedAt  DateTime  @default(now())
  isRolledBack Boolean   @default(false)
  rolledBackAt DateTime?

  bridgeEvents BridgeEvent[]

  @@index([chain, blockNumber])
  @@map("processed_blocks")
}

model BridgeEvent {
  id               String    @id @default(cuid())
  chain            String
  blockNumber      Int
  blockHash        String
  processedBlockId String
  eventId          String
  eventType        String
  sourceChain      String
  targetChain      String
  data             Json
  transactionHash  String?
  logIndex         Int?
  processed        Boolean   @default(false)
  processedAt      DateTime?

  processedBlock ProcessedBlock @relation(fields: [processedBlockId], references: [id], onDelete: Cascade)

  @@unique([chain, eventId])
  @@index([processedBlockId])
  @@map("bridge_events")
}

model ContributorProof {
  id            String   @id @default(cuid())
  workspaceId   String   @default("default")
  did           String
  walletAddress String
  githubHandle  String
  proofHash     String   @unique
  documentId    String?
  versionId     String?
  createdAt     DateTime @default(now())

  @@index([did])
  @@index([proofHash])
  @@index([workspaceId, createdAt])
  @@map("contributor_proofs")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @map("wallet_address")
  nonce         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([walletAddress], map: "idx_users_wallet_address")
  @@map("users")
}

model PayoutTransaction {
  id             String    @id @default(uuid())
  anchorId       String    @map("anchor_id")
  status         String    // ESCROWED, SETTLED, FAILED
  escrowedAt     DateTime  @default(now()) @map("escrowed_at")
  settledAt      DateTime? @map("settled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([anchorId, status], map: "idx_payout_anchor_status")
  @@map("v2_payout_transactions")
}

model SubscriptionPlan {
  id                String         @id @default(cuid())
  name              String
  description       String?
  priceXLM          Float
  billingPeriodDays Int            @default(30)
  features          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions     Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String           @id @default(cuid())
  studentId          String
  planId             String
  status             String           @default("active") // active, cancelled, expired
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean          @default(false)
  txHash             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments           PaymentRecord[]

  @@index([studentId])
  @@index([planId])
  @@map("subscriptions")
}

model PaymentRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  amountXLM      Float
  txHash         String?
  status         String       @default("completed")
  paidAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payment_records")
}

// Immutable IPFS/Filecoin pins for certificates and course media (BE-011)
model PinnedAsset {
  id               String    @id @default(cuid())
  resourceType     String
  resourceId       String
  kind             String
  cid              String
  contentType      String
  sizeBytes        Int
  sha256           String
  provider         String
  filecoinProvider String?
  filecoinCid      String?
  filecoinStatus   String    @default("pending") // pending | stored | failed | disabled
  cdnUrl           String
  gatewayVerified  Boolean   @default(false)
  verifiedGateway  String?
  verifiedAt       DateTime?
  pinLatencyMs     Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([resourceType, resourceId, kind])
  @@index([cid])
  @@map("pinned_assets")
}

// Append-only SHA-256 hash chain of audit events (BE-009)
model AuditChainEntry {
  sequence  BigInt   @id
  eventType String
  actorId   String?
  entity    String?
  entityId  String?
  payload   Json
  prevHash  String
  entryHash String   @unique
  createdAt DateTime

  @@index([createdAt])
  @@map("audit_chain_entries")
}

// Merkle roots of audit chain ranges anchored on the Stellar ledger (BE-009)
model AuditChainAnchor {
  id           String    @id @default(cuid())
  fromSequence BigInt
  toSequence   BigInt
  entryCount   Int
  merkleRoot   String
  headHash     String
  network      String
  txHash       String?
  status       String    @default("pending") // pending | anchored | failed
  error        String?
  createdAt    DateTime  @default(now())
  anchoredAt   DateTime?

  @@index([toSequence])
  @@index([status])
  @@map("audit_chain_anchors")
// Off-chain state channel between a student and a mentor (#1589 / BE-017).
// Only funding and the final (or disputed) state are settled on Soroban.
model StateChannel {
  id               String    @id @default(cuid())
  courseId         String
  contractId       String
  studentPublicKey String
  mentorPublicKey  String
  rewardStroops    String
  status           String    @default("pending_funding") // pending_funding, open, disputed, settling, settled
  latestSequence   Int       @default(0)
  latestState      Json?
  latestStudentSig String?
  latestMentorSig  String?
  fundingTxHash    String?
  settlementTxHash String?
  disputeInitiator String?
  disputeDeadline  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  updates StateChannelUpdate[]

  @@index([status, disputeDeadline])
  @@index([studentPublicKey])
  @@index([mentorPublicKey])
  @@map("state_channels")
}

model StateChannelUpdate {
  id         String   @id @default(cuid())
  channelId  String
  sequence   Int
  stateHash  String
  state      Json
  studentSig String
  mentorSig  String
  createdAt  DateTime @default(now())

  channel StateChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, sequence])
  @@map("state_channel_updates")
}

// Periodic Yjs document snapshot (#1592 / BE-020). Redis streams hold the
// updates appended since `lastStreamId`.
model YjsDocumentSnapshot {
  id           String   @id @default(cuid())
  name         String   @unique
  state        Bytes
  stateVector  Bytes
  lastStreamId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("yjs_document_snapshots")
}
